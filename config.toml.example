[general]
# Route regular DC traffic via Telegram MiddleProxy transport.
# Required when using a promotion tag from @MTProxybot.
use_middle_proxy = true

# This example enables regular MiddleProxy routing explicitly. The parser and
# fresh source-installer default is false; the Docker Compose installer default
# is true. Media paths still prefer MiddleProxy by default in either case.

# Keep media-path traffic on MiddleProxy by default, even when regular DC1..5
# traffic stays direct. Set to false if you want media to follow use_middle_proxy
# without special preference.
# force_media_middle_proxy = true

# Telemt-compatible alias for promotion tag (alternative to [server].tag).
# If both are set, [server].tag takes priority.
# ad_tag = "1234567890abcdef1234567890abcdef"

[server]
port = 443

# Override the auto-detected public IP/domain shown in startup links.
# For self-domain masking, set this to the same domain as censorship.tls_domain
# and point its DNS A record to this VPS. Tunnel deploys preserve a configured
# domain instead of replacing it with the tunnel exit IP.
# public_ip = "proxy.example.com"

# Optional IPv4 override used in MiddleProxy NAT/AES derivation.
# Pin the IPv4 embedded into MiddleProxy NAT/AES derivation. public_ip is only
# the client-facing address used in links and is never assumed to be DC egress.
# Auto-detection trusts an AWG endpoint only inside the active tunnel netns;
# otherwise it probes the process's real public egress IPv4.
# middle_proxy_nat_ip = "203.0.113.10"

# 32 hex-char promotion tag from @MTProxybot (enables sponsored channels).
# tag = "1234567890abcdef1234567890abcdef"

# TCP listen queue depth. Higher values absorb connection bursts better.
# backlog = 4096

# Maximum concurrent client connections. The pool allocates slot indexes and
# fd maps for this cap at startup; ConnectionSlot objects themselves are
# created on demand. Startup auto-clamps this to a RAM-safe estimate unless
# unsafe_override_limits=true.
# max_connections = 512

# Established relay idle timeout in seconds.
# The first client byte is independently capped at 10 seconds; configured
# values below 10 seconds lower that admission deadline.
# Default is 120; raise if your client mix keeps established relays idle longer.
# idle_timeout_sec = 120

# Per-connection random jitter for idle_timeout_sec, in percent.
# Effective idle timeout is base ± this percentage, floored to at least 5s
# and at least half the base timeout. Set 0 to disable.
# idle_timeout_jitter_pct = 15

# Conservative iOS wedge fallback for proven generic DC relays. Eligibility
# requires at least 30 seconds in the relay phase and a delivered server reply
# followed by further client traffic, so startup exchanges on fresh reconnects
# cannot arm a close loop. A later server reply must follow client payload within
# 12 seconds, and the timer starts after the userspace client queue drains.
# Media relays are excluded.
# 0 = disabled (default). If enabled, 15 is the recommended fallback.
# client_silence_close_sec = 0

# Optional fast path for an established generic relay that resumes after a quiet
# period. Any client payload cancels the candidate. The reconnect is not fast-
# eligible until it has itself been idle, which prevents reconnect loops.
# Recommended iOS tuning: 2-second close after at least 30 seconds idle.
# client_silence_fast_close_sec = 0
# client_silence_fast_after_idle_sec = 30

# Seconds to complete TLS+MTProto handshake after first byte arrives.
# Default is 15; parser enforces a minimum of 5.
# handshake_timeout_sec = 15

# Seconds to drain existing connections after the first SIGINT/SIGTERM.
# New accepts stop immediately; a second signal or the deadline closes any
# remaining connections. Default is 15; parser enforces a minimum of 1.
# graceful_shutdown_timeout_sec = 15

# Per-endpoint deadline for the TCP connect to a Telegram DC candidate.
# This is separate from the global handshake timeout: if one candidate is
# black-holed, the proxy can abandon it and try the next candidate in time.
# 0 disables this configured ceiling; the remaining global handshake budget
# is still shared across candidates and reserved direct fallback.
# dc_connect_timeout_sec = 10

# MiddleProxy per-direction stream buffer cap in KiB.
# Active ME connections start with 16 KiB C2S/S2C buffers and grow on demand
# up to min(middleproxy_buffer_kb, 3840) KiB. The event loop also keeps lazy
# shared scratch buffers; 256 KiB of headroom keeps MP/TLS framing within the
# 4 MiB relay-queue limit.
# 2048 (default) leaves headroom for 1 MiB media parts.
# 1024 is the validated minimum for reliable media downloads (Stories, video).
# Values below 1024 may cause MiddleProxyBufferOverflow on media-heavy sessions.
# Parser lower bound is 64; values above 3840 are accepted but capped at runtime.
# middleproxy_buffer_kb = 2048

# Runtime log verbosity: debug, info (default), warn, err.
# Set to "debug" to see DC routing, relay errors, and connection lifecycle details.
# Change takes effect on restart — no recompilation needed.
# log_level = "info"

# Max new connections per second per /24 (IPv4) or /48 (IPv6) subnet.
# Limits scanner/flood/DPI-probe impact. Default of 30 is generous for
# legitimate Telegram clients (3-6 connections at startup, then hold).
# Set to 0 to disable rate limiting entirely.
# rate_limit_per_subnet = 30

# By default, max_connections is auto-clamped to a RAM-safe estimate on startup.
# Set to true to disable this safety mechanism (only if you're sure your host
# has enough memory for the configured limits).
# unsafe_override_limits = false

[monitor]
# Optional: read only by the separate proxy-monitor service.
# The mtproto-proxy binary ignores this section.

# Bind address for the monitoring dashboard HTTP server.
# Default: 127.0.0.1 (localhost only).
# Set to "0.0.0.0" to expose the dashboard on all interfaces.
# WARNING: the dashboard has no authentication — use a firewall or
# reverse proxy with auth if binding to a public interface.
# host = "127.0.0.1"

# TCP port for the monitoring dashboard.
# port = 61208

[web]
# Optional Telegram Desktop 7.1+ WEB transport. It runs alongside ordinary
# FakeTLS MTProto; enabling it does not replace or disable existing links.
# The bundled setup_web.sh extends the existing Caddy masking service and runs
# `mtproto-proxy web-relay` as a separate process/container.
# enabled = false

# Optional WEB-only gate. When both enabled and only are true, the public data
# plane serves MTProto only to the trusted local/configured WEB relay. Direct
# FakeTLS clients are sent to the ordinary Caddy masking backend exactly like a
# bad secret, so existing tg://proxy links stop working. The relay is identified
# from the kernel address returned by accept(), never from a PROXY header.
# only = false

# Public DNS name in tg://webproxy links. Use a second DNS-only A record that
# points to this VPS. It MUST differ from censorship.tls_domain, because the two
# names select different Caddy paths behind the same public :443 listener.
# Requests without a valid bridge capability receive an empty 404 response.
# domain = "web.example.com"

# Plain HTTP/WebSocket relay listener behind Caddy. Keep this local.
# listen = "127.0.0.1"
# port = 8081

# Data-plane endpoint opened for each logical MTProto stream. The local default
# is this proxy on server.port. Tunnel-netns installs use 10.200.200.2:443.
# backend = "127.0.0.1:443"

# Caddy TLS listener used only for WEB-domain SNI. It accepts a PROXY v2 header
# from the main proxy so the browser address survives the masking hop.
# setup_web.sh writes 127.0.0.1:8444 (or 10.200.200.1:8444 in tunnel mode).
# mask_backend = "127.0.0.1:8444"

# Same-origin WebSocket path embedded in the authenticated bridge page.
# ws_path = "/api/v1/socket"

# Caddy supplies X-Forwarded-For from the trusted PROXY v2 address. The relay
# reads only the right-most value, which is written by the immediate hop.
# trust_forwarded_for = true
# client_ip_header = "x-forwarded-for"

# Require Origin: https://<domain> on WebSocket upgrades.
# check_origin = true

# Resource limits. Every session occupies one front/masking connection plus up
# to max_streams data-plane connections. setup_web.sh uses 8 x 32 by default,
# at most 264 of the default 512 connection slots.
# max_sessions = 8
# max_streams = 32
# max_buffer_mb = 128

# Additional relay source IP literals trusted to send the direct-obfuscated
# WEB stream into the data plane. Loopback is implicit. Tunnel-netns setup uses
# ["10.200.200.1"]. Do not list untrusted addresses or CIDRs.
# relay_sources = []

[censorship]
# Self-domain masking domain. Point this domain's DNS A record to this VPS.
# Public :443 is handled by mtproto-proxy; ordinary HTTPS clients are forwarded
# to local Caddy on mask_port and receive 404.
# Since June 2026, the masking TLS backend for this domain should negotiate
# X25519MLKEM768 (post-quantum group 0x11ec) in one round. A classical-x25519-only
# backend can mark iOS clients and other users sharing their NAT IP for blocking.
# setup_masking.sh configures Caddy with X25519MLKEM768 first and probes the
# local backend. Changing tls_domain changes every ee-secret link.
tls_domain = "proxy.example.com"

# Forward unauthenticated / invalid connections to the self-domain Caddy 404 backend
# (active probing defense).
mask = true

# Local Caddy HTTPS backend. setup_masking.sh obtains a Let's Encrypt cert via
# HTTP-01 on public :80, then configures Caddy on 127.0.0.1:8443. In tunnel
# netns mode, the runtime automatically targets 10.200.200.1:8443.
mask_port = 8443

# Maximum lifetime for an ordinary masking relay connection. This limits active
# probes that keep the Caddy 404 backend open. WEB-domain carriers are exempt.
# 0 disables the cap for all masking relays.
# mask_relay_max_secs = 0

# Split ServerHello into 1-byte + short delay + rest (defeats passive DPI signatures).
# Enabled by default.
# desync = true

# Base delay and random extra delay for the Split ServerHello path.
# Effective delay is desync_split_delay_ms + random(0..desync_split_jitter_ms).
# desync_split_delay_ms = 3
# desync_split_jitter_ms = 2

# Fake TLS encrypted-certificate AppData size in bytes.
# 0 keeps the built-in default (2878). Explicit values are clamped to 256..16384.
# fake_cert_size = 0

# Dynamic Record Sizing: ramp TLS records from 1369 → 16384 bytes to mimic browser behavior.
# Improves throughput after initial handshake, may help evade statistical traffic analysis.
# drs = false

# Delegate S2C AES encryption to the Telegram DC (reduces CPU and memory usage).
# Recommended for all deployments.
fast_mode = true

[access.users]
# 32 hex-char secret (16 bytes) per user.
# Generate with: openssl rand -hex 16
user1 = "00112233445566778899aabbccddeeff"
user2 = "ffeeddccbbaa99887766554433221100"

[access.direct_users]
# Optional: users that bypass MiddleProxy when a real direct DC path exists.
# CDN DC 203 still uses MiddleProxy because it has no direct endpoint.
# Useful for admin/service accounts that should always use fast mode.
# Names here must match keys from [access.users].
# Value must be true/1/yes to enable.
# user1 = true
