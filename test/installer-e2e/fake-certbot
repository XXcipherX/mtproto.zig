#!/usr/bin/env bash
# CI-only ACME substitute. The installer still exercises its Certbot command
# line, certificate copy, Caddy validation and renewal-hook paths without
# depending on public DNS or Let's Encrypt rate limits.
set -euo pipefail

domain=""
while (($#)); do
    case "$1" in
        -d|--domain)
            domain="${2:-}"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

[[ "$domain" =~ ^[A-Za-z0-9.-]+$ ]] || {
    echo "fake-certbot: missing or invalid -d domain" >&2
    exit 2
}

cert_dir="/etc/letsencrypt/live/${domain}"
mkdir -p "$cert_dir"
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
    -keyout "$cert_dir/privkey.pem" \
    -out "$cert_dir/fullchain.pem" \
    -days 2 -nodes -subj "/CN=${domain}" >/dev/null 2>&1
chmod 0600 "$cert_dir/privkey.pem"
chmod 0644 "$cert_dir/fullchain.pem"
printf 'fake-certbot: issued test certificate for %s\n' "$domain"
